# `npm run build:app` (vite build --mode capacitor) for the Android / iOS apps. Committed: NO SECRETS HERE.
# The apps load the bundled site from the device, so the API must be the deployed backend's full URL,
# not the relative /api the website uses. Keys like VITE_MAPTILER_KEY still come from your .env.
VITE_API_BASE_URL=https://athenspulse.vercel.app/api
VITE_USE_MOCKS=false
