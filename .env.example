# Copy to .env.local for local runs (python3 scripts/serve.py reads it); set the same in Vercel → Environment Variables.
# Free "Consumer Key" from https://developer.ticketmaster.com (My Apps). Server-side only; never sent to the browser.
TICKETMASTER_API_KEY=
# Google Maps JavaScript key for the frontend map (/api/config). Restrict it by HTTP referrer in Google Cloud Console.
GOOGLE_MAPS_API_KEY=
# City of Athens AthensGov Sandbox API key (for /api/assistant) — from whoever gave you sandbox access. Server-side only.
ATHENSGOV_SANDBOX_KEY=
# Requests per minute allowed for that key (all users share it). Docs: 100.
ATHENSGOV_REQUESTS_PER_MIN=100
# Live crowds (/api/presence, /api/crowds): Upstash Redis — Vercel Marketplace → Upstash for Redis sets these two.
# Locally without them, python3 scripts/serve.py counts in memory.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: extra secret mixed into the daily session hash
PRESENCE_SALT=
