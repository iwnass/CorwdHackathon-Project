# Copy this file to `.env` and adjust.

# true  = use the fake data in src/services/mockData.js (default, works with no backend)
# false = call the real backend
VITE_USE_MOCKS=true

# Base path the frontend calls. Keep "/api" in dev so the Vite proxy handles CORS.
# In production you can set the full URL, e.g. https://api.athenspulse.gr
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards /api requests (backend running locally)
VITE_BACKEND_URL=http://localhost:8000

# Your Buy Me a Coffee page
VITE_DONATE_URL=https://www.buymeacoffee.com/your-username

# Optional: Google Maps API key (only needed when you swap the placeholder for a real map)
VITE_GOOGLE_MAPS_API_KEY=
